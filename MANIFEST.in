include AGENT_CORE.md README.md harness pyproject.toml package.json package-lock.json
recursive-include agent-specs *.md
recursive-include docs *.md
recursive-include skills *.md *.yaml *.yml *.json
recursive-include policies *.yaml *.yml
recursive-include profiles *.yaml *.yml
recursive-include knowledge *.yaml *.yml *.md
recursive-include bughunt_harness/data *.txt *.yaml *.yml *.ql *.md
recursive-include tests *.py *.json *.yaml *.yml *.md *.js *.ts *.java *.go
include tests/fixtures/whitebox/secret-test/fixture.env
recursive-include scripts *.sh
prune .git
prune .claude
prune .codex
prune .opencode
prune node_modules
prune build
prune dist
global-exclude *.py[cod] __pycache__ *.db *.db-wal *.db-shm
