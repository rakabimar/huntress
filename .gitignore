# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Secrets / credentials — NEVER commit (spec §83) ---------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*secret*
*credential*
*_token*

# ---- Per-program state / evidence / reports (out-of-repo by default) -----
# Defense-in-depth: these must also be ignored if ever copied into the repo.
state/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
evidence/
findings/
reports/
recon/
artifacts/
browser/
burp/
logs/
checkpoints/
hunt.db

# ---- Generated runtime config (regenerated by `harness sync`) -----------
# Commit canonical sources: AGENT_CORE.md, agent-specs/, skills/,
# CLAUDE.md, AGENTS.md, .claude/settings.json, .mcp.json.
# These are generated/derived and local to a session or machine:
.claude/skills/            # symlinks into skills/, created by sync
.claude/agents/            # generated from agent-specs/ by sync
.claude/settings.local.json  # per-program bindings, written by `harness start`
.codex/sessions/
.codex/agents/
.opencode/agent/
opencode.local.json

