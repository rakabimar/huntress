# ---- Secrets / credentials — NEVER commit (spec §83) ---------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
/secrets/
/.secrets/
**/secrets.local.*
**/credentials.local.*
**/*_token.local.*

# ---- Per-program state / evidence / reports (out-of-repo by default) -----
# Defense-in-depth: these must also be ignored if ever copied into the repo.
/state/
/intake/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/evidence/
/findings/
/reports/
/recon/
/artifacts/
/browser/
/burp/
/logs/
/checkpoints/
/programs/*/state/
/programs/*/intake/
/programs/*/evidence/
/programs/*/findings/
/programs/*/reports/
/programs/*/recon/
/programs/*/artifacts/
/programs/*/browser/
/programs/*/burp/
/programs/*/logs/
/programs/*/checkpoints/
hunt.db
platform_credentials.yaml

# ---- Generated runtime config (regenerated by `harness sync`) -----------
# Commit canonical sources: AGENT_CORE.md, agent-specs/, skills/,
# CLAUDE.md, AGENTS.md, .claude/settings.json, .mcp.json.
# These are generated/derived and local to a session or machine:
# Symlinks/generated specialists created by sync.
.claude/skills/
.claude/agents/
# Per-program binding written by `harness start`.
.claude/settings.local.json
.codex/sessions/
.codex/agents/
.opencode/agent/
opencode.local.json

